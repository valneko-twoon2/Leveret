#!/bin/sh
# Enforces the commit message rules in AGENTS.md:
# English (ASCII) only, summary <= 72 chars, short body, no trailers.
# Comment lines (starting with '#') are ignored.

msg=$(sed '/^#/d' "$1")

if [ -z "$(printf '%s' "$msg" | tr -d '[:space:]')" ]; then
    exit 0 # empty message: let git abort as usual
fi

fail() {
    echo "commit-msg: $1" >&2
    exit 1
}

bad=$(printf '%s\n' "$msg" | LC_ALL=C grep -n '[^ -~	]')
if [ -n "$bad" ]; then
    echo "Offending lines:" >&2
    printf '%s\n' "$bad" >&2
    fail "commit messages must be written in English (ASCII only)."
fi

summary=$(printf '%s\n' "$msg" | head -n 1)
if [ ${#summary} -gt 72 ]; then
    fail "keep the summary line within 72 characters (currently ${#summary})."
fi

if printf '%s\n' "$msg" | grep -qiE '^(co-authored-by|signed-off-by):'; then
    fail "do not add trailers such as Co-Authored-By or Signed-off-by."
fi

body_lines=$(printf '%s\n' "$msg" | tail -n +2 | grep -c '[^[:space:]]')
if [ "$body_lines" -gt 8 ]; then
    fail "keep the body to a few bullet points (at most 8 lines, currently $body_lines)."
fi
